{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["bun", "node"]
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@shelvaldes/connectome-hub",
  "version": "0.1.0",
  "description": "A human-friendly installer and manager for the Connectome agent stack by Anima Research.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch packages/cli/src/index.ts",
    "start": "bun packages/cli/src/index.ts",
    "build": "bun run --cwd packages/cli build && bun run --cwd packages/core build",
    "test": "bun test",
    "typecheck": "bun run --cwd packages/cli typecheck && bun run --cwd packages/core typecheck"
  },
  "keywords": [
    "connectome",
    "agent",
    "ai",
    "anima",
    "animalabs",
    "llm",
    "multi-agent",
    "installer",
    "ux"
  ],
  "author": "Shel Valdés",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shelvaldes/connectome-hub.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@animalabs/connectome-host": "^0.19.0",
    "@animalabs/agent-framework": "^0.30.0",
    "@animalabs/context-manager": "^0.24.0",
    "@animalabs/membrane": "^0.8.0",
    "@animalabs/chronicle": "^0.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web UI (compartido para todos; cada uno usa su propio puerto)
WEBUI_USER=admin
WEBUI_PASS=cambia_esta_clave

# Discord
# Crea 4 bots en https://discord.com/developers/applications
# Activa el intent "Message Content" en cada bot.
MAITO_GAI_DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
MIGHT_GAEL_DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
MAITO_DAI_DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
MAITO_MEI_DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del servidor de Discord y canales permitidos
# Formato: <guild_id>:<channel_id>+<channel_id>
DISCORD_GUILD_ID=000000000000000000
DISCORD_ADMIN_USERS=000000000000000000

# Intercom (comunicación local entre agentes)
INTERCOM_PORT=3999

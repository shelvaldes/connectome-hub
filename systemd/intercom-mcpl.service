[Unit]
Description=Intercom MCP server for Connectome Familia
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/connectome-familia/intercom-mcpl
Environment="PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/root/.bun/bin/bun /opt/connectome-familia/intercom-mcpl/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
